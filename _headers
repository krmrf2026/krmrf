/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org https://mc.yandex.ru; connect-src 'self' https://*.tile.openstreetmap.org https://mc.yandex.ru https://*.mc.yandex.ru https://mc.webvisor.org; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/vendor/*
  Cache-Control: public, max-age=604800, immutable

/assets/img/*
  Cache-Control: public, max-age=604800

/data/*
  Cache-Control: public, max-age=300, must-revalidate

# Service/repository files: visible only as technical artifacts, not indexable content
/tools/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/package.json
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/package-lock.json
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/README.md
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/PUBLISHING.md
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/RECOVERY.md
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet


/KRM_RF_R4_IMPLEMENTATION_REPORT.md
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/.gitignore
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/data/pages.schema.json
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet



/releases/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
