{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Каталог публикаций KRM РФ",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "type",
      "title",
      "url",
      "section",
      "datePublished",
      "dateModified",
      "excerpt",
      "image",
      "imageAlt",
      "sourceIds"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "enum": [
          "article",
          "guide",
          "assessment",
          "dossier"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "pattern": "^/.+/$"
      },
      "section": {
        "enum": [
          "kremennaya",
          "svo",
          "lnr",
          "law",
          "civilian-impact",
          "politics",
          "assessment",
          "warcrimes"
        ]
      },
      "datePublished": {
        "type": "string",
        "format": "date"
      },
      "dateModified": {
        "type": "string",
        "format": "date"
      },
      "status": {
        "type": [
          "string",
          "null"
        ]
      },
      "excerpt": {
        "type": "string",
        "minLength": 1
      },
      "image": {
        "type": "string",
        "pattern": "^/assets/img/"
      },
      "imageAlt": {
        "type": "string"
      },
      "period": {
        "type": "string"
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "locations": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "sourceIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^src-[a-f0-9]{12}$"
        },
        "uniqueItems": true
      },
      "reviewedAt": {
        "type": "string",
        "format": "date"
      },
      "reviewAfter": {
        "type": "string",
        "format": "date"
      },
      "reviewStatus": {
        "enum": [
          "current",
          "review-due",
          "superseded",
          "archived"
        ]
      },
      "supersededBy": {
        "type": "string",
        "pattern": "^/.+/$"
      },
      "revisionHistory": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "date",
            "summary"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "home": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "important": {
            "type": "integer",
            "minimum": 1
          },
          "kremennaya": {
            "type": "integer",
            "minimum": 1
          },
          "guide": {
            "type": "integer",
            "minimum": 1
          },
          "dossier": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "guide"
            }
          }
        },
        "then": {
          "required": [
            "reviewedAt",
            "reviewAfter",
            "reviewStatus"
          ]
        }
      }
    ],
    "additionalProperties": true
  }
}
