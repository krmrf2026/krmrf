{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Реестр источников KRM РФ",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "url", "title", "publisher", "registeredAt", "status", "preservationPriority", "referencedBy"],
    "properties": {
      "id": { "type": "string", "pattern": "^src-[a-f0-9]{12}$" },
      "url": { "type": "string", "format": "uri" },
      "title": { "type": "string", "minLength": 1 },
      "publisher": { "type": "string", "minLength": 1 },
      "registeredAt": { "type": "string", "format": "date" },
      "accessedAt": { "type": ["string", "null"] },
      "archiveUrl": { "type": ["string", "null"] },
      "localCopy": { "type": ["string", "null"] },
      "sha256": { "type": ["string", "null"] },
      "status": { "enum": ["referenced", "preserved", "unavailable"] },
      "preservationPriority": { "enum": ["normal", "medium", "high"] },
      "referencedBy": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "notes": { "type": "string" }
    },
    "additionalProperties": false
  }
}
